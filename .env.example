# Copy to `.env` and fill in. Vite only exposes vars prefixed with VITE_.

# Where the API lives. Leave unset in dev — vite.config.ts proxies /api to :5000.
# VITE_API_URL=https://api.autogo.ng/api

# Customer-care WhatsApp number in international digits-only form (no + or spaces).
# Drives the floating chat button and all "chat with support" links.
VITE_WHATSAPP_SUPPORT=2347078334999

# Dev builds fall back to bundled demo data when the API is unreachable.
# Production builds show a reconnecting banner instead — set this to 1 only if
# you want a hosted PREVIEW to run on demo data. Never on the live site.
# VITE_DEMO_FALLBACK=1

# Firebase Web SDK config: Firebase console → Project settings → Your apps → Web.
# Leave these blank to run against the bundled demo accounts (password: autogo).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
